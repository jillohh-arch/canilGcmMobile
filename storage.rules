rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function claimListHas(key, value) {
      return signedIn()
        && request.auth.token.get(key, []) is list
        && request.auth.token.get(key, []).hasAny([value]);
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.get('admin', false) == true
          || request.auth.token.get('role', '') in ['admin', 'administrador']
          || claimListHas('roles', 'admin')
          || claimListHas('roles', 'administrador')
        );
    }

    function hasRaClaim() {
      return signedIn()
        && request.auth.token.get('ra', '') is string
        && request.auth.token.get('ra', '').size() > 0;
    }

    function tokenAccessProfileId() {
      return request.auth.token.get('access_profile_id', '') is string
        && request.auth.token.get('access_profile_id', '').size() > 0
        ? request.auth.token.get('access_profile_id', '')
        : 'condutor';
    }

    function currentAccessProfileId() {
      let user = firestore.get(
        /databases/(default)/documents/users/$(request.auth.token.ra)
      ).data;
      let mirrorProfileId = user.get(
        'access_profile_id',
        user.get('accessProfileId', ''),
      );
      return mirrorProfileId is string && mirrorProfileId.size() > 0
        ? mirrorProfileId
        : tokenAccessProfileId();
    }

    function activeProfileGrants(profileId, moduleId, action) {
      let profilePath = /databases/(default)/documents/access_profiles/$(profileId);
      return firestore.exists(profilePath)
        && firestore.get(profilePath).data.status == 'active'
        && firestore.get(profilePath).data.permissions.get(moduleId, {}).get(action, false) == true;
    }

    function hasAccessPermission(moduleId, action) {
      return isAdmin()
        || (
          hasRaClaim()
          && activeProfileGrants(currentAccessProfileId(), moduleId, action)
        );
    }

    function canCreateOrEdit(moduleId) {
      return hasAccessPermission(moduleId, 'create')
        || hasAccessPermission(moduleId, 'edit');
    }

    function hasOwnRecordsScope() {
      return signedIn()
        && !isAdmin()
        && request.auth.token.get('access_scope', 'global') == 'own_records';
    }

    function dogAssignedToAuth(dogId) {
      let ra = request.auth.token.get('ra', '');
      let dogPath = /databases/(default)/documents/dogs/$(dogId);
      return hasRaClaim()
        && firestore.exists(dogPath)
        && (
          firestore.get(dogPath).data.get('conductorRa', '') == ra
          || firestore.get(dogPath).data.get('conductor_ra', '') == ra
          || firestore.get(dogPath).data.get('handlerId', '') == ra
          || firestore.get(dogPath).data.get('handler_id', '') == ra
        );
    }

    function activeShiftDogMatches(dogId) {
      let ra = request.auth.token.get('ra', '');
      let shiftPath = /databases/(default)/documents/active_shifts/$(ra);
      return hasRaClaim()
        && firestore.exists(shiftPath)
        && firestore.get(shiftPath).data.get('status', '') == 'active'
        && (
          firestore.get(shiftPath).data.get('dogId', '') == dogId
          || firestore.get(shiftPath).data.get('service_dog_id', '') == dogId
          || firestore.get(shiftPath).data.get('currentDogId', '') == dogId
        );
    }

    function canAccessDogRecord(dogId) {
      return !hasOwnRecordsScope()
        || dogAssignedToAuth(dogId)
        || activeShiftDogMatches(dogId);
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isPdf() {
      return request.resource.contentType == 'application/pdf';
    }

    function isOfficeDocument() {
      return request.resource.contentType in [
        'application/msword',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
      ];
    }

    function underMegabytes(sizeMb) {
      return request.resource.size < sizeMb * 1024 * 1024;
    }

    function canWriteImage(sizeMb) {
      return signedIn() && isImage() && underMegabytes(sizeMb);
    }

    function canWritePdf(sizeMb) {
      return signedIn() && isPdf() && underMegabytes(sizeMb);
    }

    function canWriteHealthAttachment(sizeMb) {
      return signedIn()
        && (isImage() || isPdf() || isOfficeDocument())
        && underMegabytes(sizeMb);
    }

    function isHumanProfilePhoto(fileName) {
      return fileName.matches('human-[0-9]{4,12}-.*');
    }

    function canWriteProfilePhoto(fileName) {
      return canWriteImage(10)
        && (
          (
            isHumanProfilePhoto(fileName)
            && canCreateOrEdit('humans')
          )
          || (
            !isHumanProfilePhoto(fileName)
            && canCreateOrEdit('k9')
          )
        );
    }

    function canWriteAdminAttachment(moduleId, sizeMb) {
      return canWriteHealthAttachment(sizeMb) && canCreateOrEdit(moduleId);
    }

    match /profile_photos/{fileName} {
      allow read: if signedIn();
      allow create: if canWriteProfilePhoto(fileName);
      allow update, delete: if false;
    }

    match /human_documents/{ra}/{fileName} {
      allow read: if signedIn();
      allow create: if canWriteAdminAttachment('humans', 20);
      allow update, delete: if false;
    }

    match /vehicle_photos/{vehicleId}/{fileName} {
      allow read: if signedIn();
      allow create: if canWriteImage(10) && canCreateOrEdit('vehicles');
      allow update, delete: if false;
    }

    match /vehicle_documents/{vehicleId}/{fileName} {
      allow read: if signedIn();
      allow create: if canWriteAdminAttachment('vehicles', 20);
      allow update, delete: if false;
    }

    match /binomial_documents/{binomialId}/{fileName} {
      allow read: if signedIn();
      allow create: if canWriteAdminAttachment('binomials', 20);
      allow update, delete: if false;
    }

    match /inventory_items/{itemId}/{fileName} {
      allow read: if signedIn();
      allow create: if canWriteAdminAttachment('inventory', 20);
      allow update, delete: if false;
    }

    match /users/{fileName} {
      allow read: if signedIn();
      allow create: if canWriteImage(10);
      allow update, delete: if false;
    }

    match /routines/{fileName} {
      allow read: if signedIn();
      allow create: if canWriteImage(10);
      allow update, delete: if false;
    }

    match /trainings/{fileName} {
      allow read: if signedIn();
      allow create: if canWriteImage(10);
      allow update, delete: if false;
    }

    match /incidents/{fileName} {
      allow read: if signedIn();
      allow create: if canWriteImage(10);
      allow update, delete: if false;
    }

    match /health/{fileName} {
      allow read: if signedIn();
      allow create: if canWriteImage(10);
      allow update, delete: if false;
    }

    match /health/exams/{fileName} {
      allow read: if signedIn();
      allow create: if canWritePdf(20);
      allow update, delete: if false;
    }

    match /health_attachments/{dogId}/{fileName} {
      allow read: if signedIn() && canAccessDogRecord(dogId);
      allow create: if canAccessDogRecord(dogId)
        && canWriteHealthAttachment(20);
      allow update, delete: if false;
    }

    match /occurrences/{occurrenceId}/events/{fileName} {
      allow read: if signedIn();
      allow create: if canWriteImage(10);
      allow update, delete: if false;
    }

    match /occurrences/{occurrenceId}/finalization/{fileName} {
      allow read: if signedIn();
      allow create: if canWriteImage(10);
      allow update, delete: if false;
    }

    match /dogs/{dogId}/feeding_photos/{fileName} {
      allow read: if signedIn() && canAccessDogRecord(dogId);
      allow create: if canAccessDogRecord(dogId) && canWriteImage(10);
      allow update, delete: if false;
    }

    match /dogs/{dogId}/training_sessions/{sessionId}/media/{fileName} {
      allow read: if signedIn() && canAccessDogRecord(dogId);
      allow create: if canAccessDogRecord(dogId) && canWriteImage(20);
      allow update, delete: if false;
    }

    match /documentos/{dogId}/{fileName} {
      allow read: if signedIn() && canAccessDogRecord(dogId);
      allow create: if canAccessDogRecord(dogId)
        && canWriteHealthAttachment(20);
      allow update, delete: if false;
    }

    match /occurrences/{occurrenceId}/{fileName} {
      allow read: if signedIn();
      allow create: if canWritePdf(20);
      allow update, delete: if false;
    }


    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
